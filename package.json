{
  "name": "eizhu-workspace",
  "private": true,
  "type": "module",
  "main": "apps/desktop/out/main/index.cjs",
  "description": "eizhu Electron 桌面工作区",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.7 <25"
  },
  "scripts": {
    "baseline:verify": "node scripts/verify-desktop-baseline.mjs --check-source",
    "baseline:test": "node --test scripts/desktop-baseline.test.mjs",
    "desktop:dev": "electron-vite dev --config apps/desktop/electron.vite.config.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "desktop:stress": "node scripts/smoke-desktop.mjs --duration=60000",
    "check": "tsc -p tsconfig.node.json --noEmit && npm run check --workspace @eizhu/web",
    "lint": "eslint apps/desktop packages scripts/*.mjs && npm run lint --workspace @eizhu/web",
    "test": "npm run test:foundation && npm run test:unit --workspace @eizhu/web && npm run baseline:test",
    "test:foundation": "node --experimental-strip-types --test packages/*/src/**/*.test.ts apps/desktop/src/main/*.test.ts scripts/desktop-build-settings.test.mjs scripts/prepare-desktop-release.test.mjs",
    "native:rebuild": "node scripts/rebuild-native.mjs",
    "postinstall": "npm run native:rebuild",
    "desktop:smoke:package": "node scripts/smoke-package.mjs",
    "format": "prettier --write apps/desktop/src packages apps/web/src/api apps/web/src/lib/bridge.ts apps/web/src/lib/platform.ts apps/web/src/lib/settingsStorage.ts scripts/{build-desktop,package-desktop,smoke-desktop,smoke-package}.mjs",
    "architecture:verify": "node scripts/verify-desktop-architecture.mjs",
    "desktop:delivery:verify": "node scripts/verify-desktop-delivery.mjs"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.2",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.5.0",
    "globals": "17.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "@types/ssh2": "1.15.6",
    "jsdom": "30.0.1",
    "vitest": "5.0.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "19.2.17"
  }
}
